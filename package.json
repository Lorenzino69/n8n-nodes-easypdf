{
	"name": "n8n-nodes-easypdf",
	"version": "0.1.0",
	"description": "n8n community node for the EasyPDF API: generate PDFs from HTML, Markdown or templates, convert DOCX and HTML files to PDF, render previews and read API usage.",
	"license": "MIT",
	"homepage": "https://www.easypdf.fr/api-docs",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"easypdf",
		"pdf",
		"pdf-generation",
		"html-to-pdf",
		"markdown-to-pdf",
		"docx-to-pdf"
	],
	"author": {
		"name": "EasyPDF",
		"email": "hello@easypdf.fr",
		"url": "https://www.easypdf.fr"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Lorenzino69/n8n-nodes-easypdf.git"
	},
	"bugs": {
		"url": "https://github.com/Lorenzino69/n8n-nodes-easypdf/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/EasyPdfApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/EasyPdf/EasyPdf.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.48.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
